# Pfad und User anpassen, dann:
#   cp deploy/jahreskalender.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now jahreskalender
[Unit]
Description=Jahreskalender (Port 8005)
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/jahreskalender
ExecStart=/usr/bin/python3 run.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
