# Kalenderjahr
KAL_YEAR=2027
# Erster Admin – wird angelegt, falls es diesen Benutzer noch nicht gibt
ADMIN_USER=stefan
ADMIN_PASSWORD=mindestens-8-zeichen

# Basis für Links in Mails und im Kalender-Abo
PUBLIC_URL=https://racingkalender.de

# Mailversand über Brevo (Registrierung, Passwort vergessen) – ohne Key bleibt beides ausgeblendet
BREVO_API_KEY=
# Bei Brevo verifizierte Absenderadresse
MAIL_FROM=no-reply@racingkalender.de
MAIL_FROM_NAME=racingkalender.de
# Empfänger der Info bei Neuanmeldung (mehrere mit Komma trennen)
ADMIN_EMAIL=
# 0 = Registrierung abschalten (Passwort vergessen bleibt aktiv)
REGISTRATION_OPEN=1

# Fußzeile „hosted on instant-run“
INSTANTRUN_SITE=https://instant-run.com
